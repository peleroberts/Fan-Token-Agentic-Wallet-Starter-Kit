{
  "name": "fan-token-agentic-wallet-starter-kit",
  "version": "1.0.0",
  "description": "Open-source starter kit for building agentic wallets for Fan Tokens on Chiliz Chain. Payments, governance, rewards, streaming — bring your own LLM.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/fan-token-agentic-wallet-starter-kit"
  },
  "keywords": [
    "chiliz", "fan-tokens", "agentic-wallet", "web3", "sportfi",
    "payments", "streaming-payments", "governance", "loyalty",
    "claude", "openai", "llm", "blockchain", "evm", "socios"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "example:matchday":   "tsx examples/match-day-wallet/index.ts",
    "example:streaming":  "tsx examples/streaming-payments/index.ts",
    "example:governance": "tsx examples/governance-agent/index.ts",
    "example:loyalty":    "tsx examples/loyalty-rewards/index.ts",
    "example:portfolio":  "tsx examples/multi-club-portfolio/index.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.36.0",
    "viem": "^2.21.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "openai": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "openai": { "optional": true }
  }
}
